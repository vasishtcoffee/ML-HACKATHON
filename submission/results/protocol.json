    "forest": {
      "n_estimators": 80,
      "max_depth": 16,
      "min_samples_leaf": 10
    },
    "xgboost": {
      "n_estimators": 240,
      "max_depth": 5,
      "learning_rate": 0.07,
      "min_child_weight": 12,
      "subsample": 0.85,
      "colsample_bytree": 0.9,
      "reg_lambda": 5.0
    },
    "mlp": {
      "epochs": 12,
      "learning_rate": 0.001,
      "weight_decay": 0.0001,
      "batch_size": 16384
